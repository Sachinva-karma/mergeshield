# ==========================================
# MergeShield Environment Configuration
# ==========================================

# 1. Model Provider Configuration (Open-Weight Models)
# Supported options: groq | openrouter | together | openai_compatible
MODEL_PROVIDER=groq

# Default model: Qwen 3.8 27B (License: Apache 2.0 Open Weights)
MODEL_NAME=qwen/qwen3.8-27b

# Provide your API key for the chosen provider:
GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# TOGETHER_API_KEY=your_together_api_key_here
# OPENAI_BASE_URL=http://localhost:11434/v1

# 2. GitHub Token (Optional but recommended)
# Public PR retrieval works without a token (up to 60 req/hour).
# Providing a personal access token increases your rate limit to 5,000 req/hour.
# MergeShield will also automatically detect your local `gh` CLI token if logged in.
GITHUB_TOKEN=

# 3. Diff Guardrails (Bounds)
MAX_DIFF_LINES=1500
MAX_DIFF_BYTES=200000
